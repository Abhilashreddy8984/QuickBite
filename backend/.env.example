# ==============================================================================
# QuickBite Backend Environment Variables Template
# Copy this file to '.env' inside the 'backend' folder and update the values.
# NEVER commit your real '.env' file containing secrets to version control.
# ==============================================================================

# Port number for the Express server to listen on (Default: 5000)
PORT=5000

# Node environment mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas - Cloud):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quickbite?retryWrites=true&w=majority

# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Allowed Frontend Origins for CORS (comma-separated or single origin)
# Add your deployed Render frontend URL here (e.g. https://quickbite-frontend.onrender.com)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,https://quickbite-frontend.onrender.com
